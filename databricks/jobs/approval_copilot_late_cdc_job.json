{
  "name": "approval_copilot_late_cdc",
  "description": "Approval Rate Copilot: late-data test for AUTO CDC. Lands two batches of synthetic acquirer status events in the schema approval_copilot_cdc, the second late and out of order, updates the approval_copilot_late_cdc pipeline after each, and checks that the current status follows the acquirer's sequence, not the arrival order. Touches none of the copilot's tables. Generated by tools/build_databricks.py.",
  "max_concurrent_runs": 1,
  "tags": {
    "project": "approval-rate-copilot",
    "data": "synthetic"
  },
  "tasks": [
    {
      "task_key": "land_batch_1",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/12_late_cdc_feed",
        "source": "WORKSPACE",
        "base_parameters": {
          "batch": "1"
        }
      },
      "max_retries": 0,
      "timeout_seconds": 1800
    },
    {
      "task_key": "update_after_batch_1",
      "depends_on": [
        {
          "task_key": "land_batch_1"
        }
      ],
      "pipeline_task": {
        "pipeline_id": "${CDC_PIPELINE_ID}",
        "full_refresh": true
      },
      "max_retries": 0,
      "timeout_seconds": 1800
    },
    {
      "task_key": "land_batch_2_late",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/12_late_cdc_feed",
        "source": "WORKSPACE",
        "base_parameters": {
          "batch": "2"
        }
      },
      "max_retries": 0,
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "update_after_batch_1"
        }
      ]
    },
    {
      "task_key": "update_after_batch_2",
      "depends_on": [
        {
          "task_key": "land_batch_2_late"
        }
      ],
      "pipeline_task": {
        "pipeline_id": "${CDC_PIPELINE_ID}",
        "full_refresh": false
      },
      "max_retries": 0,
      "timeout_seconds": 1800
    },
    {
      "task_key": "check",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/13_late_cdc_check",
        "source": "WORKSPACE"
      },
      "max_retries": 0,
      "timeout_seconds": 1800,
      "depends_on": [
        {
          "task_key": "update_after_batch_2"
        }
      ]
    }
  ]
}
