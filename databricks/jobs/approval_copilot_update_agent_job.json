{
  "name": "approval_copilot_update_agent",
  "description": "Approval Rate Copilot: check and apply the serialized Genie space and the dashboard file from the repository. Generated by tools/build_databricks.py.",
  "max_concurrent_runs": 1,
  "tags": {
    "project": "approval-rate-copilot",
    "data": "synthetic"
  },
  "tasks": [
    {
      "task_key": "update_agent",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/10_update_agent",
        "source": "WORKSPACE",
        "base_parameters": {
          "space_json_path": "${PAYLOAD_DIR}/approval_copilot_agent.json",
          "dashboard_json_path": "${PAYLOAD_DIR}/approval_health.lvdash.json",
          "warehouse_id": "${WAREHOUSE_ID}"
        }
      },
      "max_retries": 0,
      "timeout_seconds": 1800
    }
  ]
}
