{
  "name": "approval_copilot_daily",
  "description": "Approval Rate Copilot: land the synthetic feeds, check them against their contracts, refresh the pipeline, build and test the gold tables with dbt, run the forecast alert, recreate the copilot functions and column descriptions, and apply governance tags. Generated by tools/build_databricks.py.",
  "parameters": [
    {
      "name": "run_date",
      "default": ""
    },
    {
      "name": "regenerate_data",
      "default": "false"
    }
  ],
  "email_notifications": {
    "on_failure": [
      "${OWNER_EMAIL}"
    ],
    "no_alert_for_skipped_runs": true
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "schedule": {
    "quartz_cron_expression": "0 0 7 * * ?",
    "timezone_id": "America/Bogota",
    "pause_status": "PAUSED"
  },
  "tags": {
    "project": "approval-rate-copilot",
    "data": "synthetic"
  },
  "environments": [
    {
      "environment_key": "dbt",
      "spec": {
        "environment_version": "4",
        "dependencies": [
          "dbt-databricks>=1.10,<2"
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "setup",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/00_setup",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 3600
    },
    {
      "task_key": "land_data",
      "depends_on": [
        {
          "task_key": "setup"
        }
      ],
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/01_generate_data",
        "source": "WORKSPACE",
        "base_parameters": {
          "regenerate_data": "{{job.parameters.regenerate_data}}"
        }
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 3600
    },
    {
      "task_key": "check_feeds",
      "depends_on": [
        {
          "task_key": "land_data"
        }
      ],
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/06_check_feeds",
        "source": "WORKSPACE",
        "base_parameters": {
          "run_date": "{{job.parameters.run_date}}",
          "regenerate_data": "{{job.parameters.regenerate_data}}"
        }
      },
      "max_retries": 0,
      "timeout_seconds": 3600
    },
    {
      "task_key": "refresh_pipeline",
      "depends_on": [
        {
          "task_key": "check_feeds"
        }
      ],
      "pipeline_task": {
        "pipeline_id": "${PIPELINE_ID}",
        "full_refresh": false
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 3600
    },
    {
      "task_key": "dbt_build",
      "depends_on": [
        {
          "task_key": "refresh_pipeline"
        }
      ],
      "dbt_task": {
        "project_directory": "${DBT_PROJECT_DIR}",
        "commands": [
          "dbt build"
        ],
        "warehouse_id": "${WAREHOUSE_ID}",
        "catalog": "workspace",
        "schema": "approval_copilot",
        "source": "WORKSPACE"
      },
      "environment_key": "dbt",
      "max_retries": 0,
      "timeout_seconds": 3600
    },
    {
      "task_key": "volume_alerts",
      "depends_on": [
        {
          "task_key": "dbt_build"
        }
      ],
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/07_volume_alerts",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 3600
    },
    {
      "task_key": "copilot_functions",
      "depends_on": [
        {
          "task_key": "dbt_build"
        }
      ],
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/04_copilot_functions",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 3600
    },
    {
      "task_key": "column_comments",
      "depends_on": [
        {
          "task_key": "dbt_build"
        }
      ],
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/05_column_comments",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 3600
    },
    {
      "task_key": "metric_views",
      "depends_on": [
        {
          "task_key": "dbt_build"
        }
      ],
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/09_metric_views",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 3600
    },
    {
      "task_key": "governance",
      "depends_on": [
        {
          "task_key": "volume_alerts"
        },
        {
          "task_key": "copilot_functions"
        },
        {
          "task_key": "column_comments"
        },
        {
          "task_key": "metric_views"
        }
      ],
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/08_governance",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 60000,
      "retry_on_timeout": true,
      "timeout_seconds": 3600
    }
  ]
}
