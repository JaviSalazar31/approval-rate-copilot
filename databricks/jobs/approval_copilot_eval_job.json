{
  "name": "approval_copilot_eval",
  "description": "Approval Rate Copilot: ask the Genie agent a question set and log each answer to MLflow as a trace (latency, SQL, guardrail checks), or attach graded verdicts to a run. Generated by tools/build_databricks.py.",
  "parameters": [
    {
      "name": "action",
      "default": "ask"
    },
    {
      "name": "question_set",
      "default": "benchmark"
    },
    {
      "name": "run_name",
      "default": ""
    },
    {
      "name": "graded_path",
      "default": ""
    }
  ],
  "email_notifications": {
    "on_failure": [
      "${OWNER_EMAIL}"
    ],
    "no_alert_for_skipped_runs": true
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "schedule": {
    "quartz_cron_expression": "0 0 8 ? * MON",
    "timezone_id": "America/Bogota",
    "pause_status": "PAUSED"
  },
  "tags": {
    "project": "approval-rate-copilot",
    "data": "synthetic"
  },
  "tasks": [
    {
      "task_key": "evaluate",
      "notebook_task": {
        "notebook_path": "${NOTEBOOK_DIR}/11_evaluate_agent",
        "source": "WORKSPACE",
        "base_parameters": {
          "action": "{{job.parameters.action}}",
          "question_set": "{{job.parameters.question_set}}",
          "run_name": "{{job.parameters.run_name}}",
          "graded_path": "{{job.parameters.graded_path}}"
        }
      },
      "max_retries": 0,
      "timeout_seconds": 7200
    }
  ]
}
